{
  "name": "@open-usecase/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "tokens": "os-tokens",
    "serve": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "stylelint": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@angular/aria": "~22.2.4",
    "@angular/cdk": "~22.2.4",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@openstuff-dev/announce": "^0.1.0",
    "@openstuff-dev/tokens": "^0.1.1",
    "@openstuff-dev/ui": "^0.1.8",
    "@openstuff-dev/ui-angular": "^0.1.8",
    "@openstuff-dev/version": "^0.1.0",
    "lucide": "^1.66.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "~22.2.3",
    "@open-usecase/contracts": "*",
    "@playwright/test": "^1.65.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "nx": {
    "name": "web",
    "tags": [
      "type:app"
    ],
    "targets": {
      "e2e": {
        "command": "playwright test",
        "options": {
          "cwd": "apps/web"
        },
        "dependsOn": [
          "build",
          "server:build"
        ]
      },
      "tokens": {
        "cache": true,
        "inputs": [
          "{projectRoot}/tokens.config.json",
          {
            "externalDependencies": [
              "@openstuff-dev/tokens"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/tokens"
        ]
      },
      "build": {
        "dependsOn": [
          "tokens"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "dependsOn": [
          "tokens"
        ],
        "continuous": true
      },
      "watch": {
        "dependsOn": [
          "tokens"
        ],
        "continuous": true
      },
      "typecheck": {
        "dependsOn": [
          "tokens"
        ]
      },
      "stylelint": {
        "dependsOn": [
          "tokens"
        ]
      }
    }
  }
}
