# Copy to .env and adjust. docker compose reads it automatically.

# Port on this machine.
PORT=8080

# How much the server logs: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# The database password compose sets up. Change it before you put this on a network.
POSTGRES_PASSWORD=openusecase

# Where people reach OpenUsecase. Cookies are marked secure when this starts with https://.
OPENUSECASE_PUBLIC_URL=http://localhost:8080

# The first admin. Without a password, one is made and shown once in the server log.
OPENUSECASE_ADMIN_EMAIL=admin@example.com
OPENUSECASE_ADMIN_PASSWORD=

# How long someone stays signed in, in days.
OPENUSECASE_SESSION_DAYS=30

# Behind a reverse proxy: true, or the proxy's addresses. Leave empty otherwise.
OPENUSECASE_TRUST_PROXY=

# The largest test report CI may upload, in bytes. The file isn't stored.
OPENUSECASE_REPORT_MAX_BYTES=20971520

# Encrypts the OpenPurpose token. Set a long random value on a server. Without it, a key is made and
# kept in the database, so a database dump alone could reveal the token.
OPENUSECASE_SECRET_KEY=

# This server only calls public addresses, so a URL someone enters can't reach into your network.
# Set to private if OpenPurpose runs on your own network, and list its hosts in the allow list.
OPENUSECASE_FETCH=public
OPENUSECASE_FETCH_ALLOW=
